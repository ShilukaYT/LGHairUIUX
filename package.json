{
  "name": "lghair-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"node scripts/dev-proxy.mjs\" \"pnpm --parallel -r run dev\"",
    "dev:admin": "pnpm --filter minhtam dev",
    "dev:customer": "pnpm --filter lghairuiux dev",
    "build": "pnpm -r run build",
    "preview:admin": "pnpm --filter minhtam preview",
    "preview:customer": "pnpm --filter lghairuiux preview"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "concurrently": "^10.0.0",
    "http-proxy": "^1.18.1"
  },
  "dependencies": {
    "js-cookie": "^3.0.8",
    "pnpm": "^11.5.1"
  }
}
